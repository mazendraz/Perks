# Copying this template is optional: npm run db:up creates random LOCAL credentials.
APP_ENV=development
HOST=127.0.0.1
PORT=4100
PUBLIC_APP_ORIGIN=http://127.0.0.1:5173
AUTH_PROVIDER=local
# staging/production: AUTH_PROVIDER=password, HTTPS origin and COOKIE_SECURE=true.
DATABASE_URL=
DATABASE_MIGRATOR_URL=
AUTH_DATABASE_URL=
WORKER_DATABASE_URL=
AUTH_PEPPER=
COOKIE_SECURE=false
MAIL_TRANSPORT=file
# File mail sink is development/test only. Production requires SMTP + TLS.
MAIL_FILE_ROOT=.local/mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
SMTP_STARTTLS=true
# Optional private CA certificate for a self-hosted SMTP server (never a private key).
# SMTP_CA_FILE=/etc/nuqta/smtp-ca.pem
LOG_LEVEL=info
