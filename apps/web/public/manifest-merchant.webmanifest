{
  "id": "/merchant",
  "name": "Perks Business",
  "short_name": "Perks Business",
  "description": "تابع محلك وعملاءك وكارت الولاء بتاعك.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "/merchant",
  "scope": "/merchant",
  "display": "standalone",
  "theme_color": "#181B38",
  "background_color": "#F5F5F1",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/perks-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/perks-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/perks-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest-merchant.webmanifest"
    }
  ]
}
